<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FF222338" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <FrameLayout
            android:id="@+id/add"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="Add expense">

            <ImageView
                android:id="@+id/add_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_button"
                android:tint="#FFFF8A65" />

            <ImageView
                android:id="@+id/add_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_add" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="Add by voice">

            <ImageView
                android:id="@+id/voice_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_button"
                android:tint="#FF8B7CFF" />

            <ImageView
                android:id="@+id/voice_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="12dp"
                android:src="@drawable/ic_mic" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
